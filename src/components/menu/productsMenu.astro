---
import CofeeMenu from './coffeeMenu.astro';
import FoodMenu from './foodMenu.astro';
---

<section class="bg-coffee-800 pt-10 pb-5 -mt-20">
  <div
    class="max-w-7xl
    mx-auto
    bg-menu-image
    bg-no-repeat
    bg-contain
    bg-position-[center_80px]
    pt-36
    lg:pt-64
    pb-40"
  >
    <h3 class="text-white font-black text-center text-xl pb-3 uppercase">
      Nuestro Delicioso
      <span class="text-4xl block">Menú</span>
    </h3>
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-5 mt-10">
      <CofeeMenu />
      <FoodMenu />
    </div>
  </div>
</section>
