---
import GalleryGrid from '@/components/gallery/gallery_grid.astro';
import { GalleryPageSchema } from '@/types';
const API_URL = import.meta.env.PUBLIC_WORDPRESS_API;
const url = `${API_URL}/pages?slug=galeria`;
const res = await fetch(url);
const json = await res.json();
const data = GalleryPageSchema.parse(json[0]);
---

<section class="bg-white px-5 lg:px-20 pb-25 max-w-7xl mx-auto -mt-10 relative">
  <h2 class="text-coffee-400 text-center font-black text-lg uppercase pb-5">
    Vive la
    <span class="text-coffee-900 text-4xl block">experiencia</span>
  </h2>
  <GalleryGrid gallery={data.gallery} />
</section>
