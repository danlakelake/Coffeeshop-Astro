---
import { Picture } from 'astro:assets';
import type { Gallery } from '@/types';
interface Props {
  gallery: Gallery[];
  background?: boolean;
}

const { gallery } = Astro.props;
const { background = false } = Astro.props;
---

<div
  id="gallery"
  class="grid grid-cols-1 lg:grid-cols-3 gap-5 p-5"
  class:list={['gallery', background && 'bg-coffee-900']}
>
  {
    gallery.map((image) => {
      return (
        <a
          href={image.full.url}
          data-pswp-width={image.full.width}
          data-pswp-height={image.full.height}
        >
          <Picture
            src={image.large.url}
            alt="Galería de imágenes"
            width={image.large.width}
            height={image.large.height}
            formats={['avif', 'webp']}
            class="rounded-md"
          />
        </a>
      );
    })
  }
</div>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '#gallery',
    children: 'a',
    pswpModule: () => import('photoswipe'),
  });

  function initPhotoSwipe() {
    lightbox.init();
  }

  document.addEventListener('DOMContentLoaded', initPhotoSwipe);
  document.addEventListener('astro:after-swap', initPhotoSwipe);
</script>
