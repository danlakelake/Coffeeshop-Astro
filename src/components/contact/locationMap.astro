---
import type { Location } from '@/types';

interface Props {
  location: Location;
}

const { location } = Astro.props;
---

<div>
  <h3 class="text-coffee-900 font-black text-center text-2xl uppercase mb-5">
    Ubicación
  </h3>
  <div id="map" class="h-125"></div>
  <location-data
    data-lat={location.lat}
    data-lng={location.lng}
    data-zoom={location.zoom}
    data-label={location.markers[0].label}
    data-markerlat={location.markers[0].lat}
    data-markerlng={location.markers[0].lng}
  >
  </location-data>
</div>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  class LocationData extends HTMLElement {
    connectedCallback() {
      const lat = Number(this.dataset.lat);
      const lng = Number(this.dataset.lng);
      const zoom = Number(this.dataset.zoom);
      const label = this.dataset.label || '';
      const markerLat = Number(this.dataset.markerlat);
      const markerLng = Number(this.dataset.markerlng);

      if (lat && lng && zoom && markerLat && markerLng) {
        const map = L.map('map').setView([lat, lng], zoom);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(
          map,
        );
        L.marker([markerLat, markerLng])
          .addTo(map)
          .bindPopup(label)
          .openPopup();
      }
    }
  }

  customElements.define('location-data', LocationData);
</script>
